VLLM_MODEL=RedHatAI/Llama-3.3-70B-Instruct-quantized.w4a16
HF_TOKEN=hf_your_token_here
VLLM_API_KEY=change-me-to-a-secure-random-key

# GPU & Memory tuning for 2x RTX 3090 (24GB each, 48GB total)
TENSOR_PARALLEL_SIZE=2
GPU_MEMORY_UTILIZATION=0.92
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=128
MAX_NUM_BATCHED_TOKENS=8192

# Performance flags
ENABLE_PREFIX_CACHING=true
VLLM_ATTENTION_BACKEND=FLASH_ATTN
VLLM_WORKER_MULTIPROC_METHOD=spawn

# Network
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
SERVER_HOSTNAME=llm.local

# Model alias in OpenAI API calls
SERVED_MODEL_NAME=llama-3.3-70b

# Optional: Pipeline parallelism alternative (set PP=2, TP=1 in docker-compose.pp.yml)
# PP is often better than TP for PCIe-connected GPUs like dual RTX 3090s
PIPELINE_PARALLEL_SIZE=1

# Monitoring (optional)
ENABLE_MONITORING=false
PROMETHEUS_RETENTION=15d
